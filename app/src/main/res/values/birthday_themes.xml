<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BirthdayLight" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#235D45</item>
        <item name="android:windowBackground">#F2F2F2</item>
        <item name="android:statusBarColor">#173E2D</item>
        <item name="android:navigationBarColor">#F2F2F2</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="android:textColorHint">#000000</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/BirthdayLightDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/BirthdayLightDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/BirthdayLightDialogButton</item>
    </style>
    <style name="BirthdayDark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#A0DAB5</item>
        <item name="android:windowBackground">#171717</item>
        <item name="android:statusBarColor">#173E2D</item>
        <item name="android:navigationBarColor">#171717</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="android:textColorHint">#FFFFFF</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/BirthdayDarkDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/BirthdayDarkDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/BirthdayDarkDialogButton</item>
    </style>
    <style name="BirthdayGray" parent="@style/BirthdayDark">
        <item name="android:windowBackground">#686868</item>
        <item name="android:colorBackground">#585858</item>
        <item name="android:navigationBarColor">#686868</item>
    </style>
    <style name="BirthdayLightDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#000000</item>
    </style>
    <style name="BirthdayDarkDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
